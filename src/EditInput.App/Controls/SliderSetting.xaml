<UserControl x:Class="EditInput.App.Controls.SliderSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,0,0,14">
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding Label, ElementName=Root}" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Hint, ElementName=Root}" Style="{StaticResource Hint}" Margin="8,0,0,0" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider Minimum="{Binding Minimum, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}"
                    Value="{Binding Value, ElementName=Root, Mode=TwoWay}" SmallChange="1" LargeChange="5"
                    VerticalAlignment="Center" AutomationProperties.Name="{Binding Label, ElementName=Root}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <TextBox x:Name="Box" Width="58" TextAlignment="Right" PreviewKeyDown="OnBoxKeyDown" LostKeyboardFocus="OnBoxLostFocus"
                         AutomationProperties.Name="{Binding Label, ElementName=Root}" />
                <TextBlock Text="{Binding Unit, ElementName=Root}" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="6,0,0,0" Width="22" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
