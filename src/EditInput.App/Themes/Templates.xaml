<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:EditInput.App.ViewModels"
                    xmlns:c="clr-namespace:EditInput.App.Controls"
                    xmlns:val="clr-namespace:EditInput.Core.Validation;assembly=EditInput.Core">

    <!-- Merged here so StaticResource lookups below never depend on sibling dictionary order. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <c:BoolToVisibilityConverter x:Key="BoolToVis" />
    <c:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <c:EnumEqualsConverter x:Key="EnumEquals" />
    <c:EnumToVisibilityConverter x:Key="EnumToVis" />
    <c:FractionToLengthConverter x:Key="FractionToLength" />
    <c:ZeroToVisibleConverter x:Key="ZeroToVis" />

    <!-- Keycap bind tile:  ┌ ⌨ EDIT        ✕ ┐
                            │        E        │
                            └ click to change ┘ -->
    <DataTemplate x:Key="BindSlotTemplate" DataType="{x:Type vm:BindSlotViewModel}">
        <Grid Margin="0,0,0,14">
            <Button Style="{StaticResource BindButton}" Command="{Binding CaptureCommand}"
                    AutomationProperties.Name="{Binding Label}"
                    ToolTip="Click, then press a key, mouse button or controller button">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DeviceGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding Display}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontSize" Value="26" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="15" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="2" Text="click to change" FontSize="10" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Opacity="0.7" />
                </Grid>
            </Button>
            <Button Content="&#xE711;" Command="{Binding ClearCommand}" ToolTip="Clear bind"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" FontSize="10">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AllowClear}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </DataTemplate>

    <!-- Card heading with the gradient accent bar. Use: ContentControl Content="Title" ContentTemplate=CardHeader -->
    <DataTemplate x:Key="CardHeader">
        <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource TitleBar}" />
            <TextBlock Text="{Binding}" Style="{StaticResource CardTitle}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="IssueTemplate" DataType="{x:Type val:BindIssue}">
        <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource AmberSoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
