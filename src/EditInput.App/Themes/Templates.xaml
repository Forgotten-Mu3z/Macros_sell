<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:EditInput.App.ViewModels"
                    xmlns:c="clr-namespace:EditInput.App.Controls"
                    xmlns:val="clr-namespace:EditInput.Core.Validation;assembly=EditInput.Core">

    <!-- Merged here so StaticResource lookups below never depend on sibling dictionary order. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <c:BoolToVisibilityConverter x:Key="BoolToVis" />
    <c:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <c:EnumEqualsConverter x:Key="EnumEquals" />
    <c:EnumToVisibilityConverter x:Key="EnumToVis" />
    <c:FractionToLengthConverter x:Key="FractionToLength" />
    <c:ZeroToVisibleConverter x:Key="ZeroToVis" />

    <!-- A labelled, clickable bind box:  EDIT  [ E ] -->
    <DataTemplate x:Key="BindSlotTemplate" DataType="{x:Type vm:BindSlotViewModel}">
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" />
            <Grid>
                <Button Style="{StaticResource BindButton}" Command="{Binding CaptureCommand}"
                        AutomationProperties.Name="{Binding Label}"
                        ToolTip="Click, then press a key, mouse button or controller button">
                    <Grid>
                        <TextBlock Text="{Binding DeviceGlyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Display}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="FontSize" Value="14" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
                <Button Content="&#xE711;" Command="{Binding ClearCommand}" ToolTip="Clear bind"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AllowClear}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="IssueTemplate" DataType="{x:Type val:BindIssue}">
        <Border CornerRadius="7" Padding="10,8" Margin="0,0,0,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource AmberSoftBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
