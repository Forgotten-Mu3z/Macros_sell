<UserControl x:Class="EditInput.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ContentControl Content="Startup" ContentTemplate="{StaticResource CardHeader}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.StartWithWindows}" Content="Start With Windows" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.StartMinimized}" Content="Start Minimized" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.MinimizeToTray}" Content="Minimize To Tray" Margin="0,0,0,12" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.EnableOnLaunch}" Content="Enable automation on launch" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ContentControl Content="Input" ContentTemplate="{StaticResource CardHeader}" />
                        <TextBlock Text="CONTROLLER POLLING RATE" Style="{StaticResource SectionLabel}" />
                        <ComboBox ItemsSource="{Binding Settings.PollRates}" DisplayMemberPath="Display" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.ControllerPollRateHz}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                                   Text="Full-rate polling only runs while a controller input is bound or the controller view is open." />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.IgnoreForeignInjectedInput}"
                                  Content="Ignore input generated by other software" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Input generated by this app is always ignored (no feedback loops). Turn this on to also ignore keys sent by other tools; leave it off if you use Steam Input keyboard mappings as your Edit key." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ContentControl Content="Global Hotkeys" ContentTemplate="{StaticResource CardHeader}" />
                        <ContentControl Content="{Binding Settings.Toggle}" ContentTemplate="{StaticResource BindSlotTemplate}" />
                        <ContentControl Content="{Binding Settings.EmergencyStop}" ContentTemplate="{StaticResource BindSlotTemplate}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="These work in every profile. Emergency Stop can't be an input the app generates, and after it fires you must click ENABLE to continue." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ContentControl Content="Data &amp; Privacy" ContentTemplate="{StaticResource CardHeader}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Everything is stored locally in settings.json and profiles.json. No account, no network access, nothing is uploaded." />
                        <TextBlock Text="{Binding Settings.DataDirectory}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Content="Open Data Folder" Command="{Binding Settings.OpenDataFolderCommand}" Margin="0,0,8,8" />
                            <Button Content="Open Log Folder" Command="{Binding Settings.OpenLogFolderCommand}" Margin="0,0,8,8" />
                            <Button Content="Show Welcome" Command="{Binding Settings.ShowWelcomeCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                            <Run Text="Version " /><Run Text="{Binding Settings.Version, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
