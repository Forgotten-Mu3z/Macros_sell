<UserControl x:Class="EditInput.App.Views.ControllerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EditInput.App.Controls">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ContentControl Content="Controller" ContentTemplate="{StaticResource CardHeader}" />
                    <TextBlock Text="STATUS" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource GrayBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Controller.IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Controller.Status}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Text="USE CONTROLLER" Style="{StaticResource SectionLabel}" />
                    <ComboBox ItemsSource="{Binding Controller.SlotOptions}" DisplayMemberPath="Display" SelectedValuePath="Value"
                              SelectedValue="{Binding Editor.ControllerSlot}" Margin="0,0,0,14" AutomationProperties.Name="Controller slot" />

                    <TextBlock Text="VIRTUAL CONTROLLER OUTPUT" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding Controller.VirtualPadStatus}" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="11"
                               Text="Controller buttons can always be used as inputs. Generating controller outputs (e.g. SELECT = RT) needs the free ViGEmBus driver; see README." />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <ContentControl Content="Sensitivity" ContentTemplate="{StaticResource CardHeader}" />
                    <c:SliderSetting Label="TRIGGER THRESHOLD" Hint="LT / RT count as pressed above this" Unit="%"
                                     Minimum="5" Maximum="95" Value="{Binding Editor.TriggerThresholdPercent}" />
                    <c:SliderSetting Label="STICK DEADZONE" Hint="Used when stick directions are binds" Unit="%"
                                     Minimum="0" Maximum="40" Value="{Binding Editor.StickDeadzonePercent}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="A small hysteresis below the trigger threshold prevents flicker when a trigger rests near the threshold." />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <ContentControl Content="Live Controller View" ContentTemplate="{StaticResource CardHeader}" />
                    <TextBlock Text="Press a button to highlight it. Outlined buttons are used by the current profile."
                               Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </DockPanel>
                <Viewbox MaxHeight="340" Stretch="Uniform">
                    <Canvas Width="560" Height="300">
                        <!-- body -->
                        <Path Fill="{StaticResource PanelBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="2"
                              Data="M 150,72 L 410,72 C 470,72 505,110 520,170 C 535,235 530,290 480,290 C 440,290 425,245 390,235 L 170,235 C 135,245 120,290 80,290 C 30,290 25,235 40,170 C 55,110 90,72 150,72 Z" />

                        <!-- triggers -->
                        <Border Canvas.Left="78" Canvas.Top="8" Width="92" Height="28" CornerRadius="6" Background="{StaticResource CardHoverBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Border HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Opacity="0.75"
                                        Width="{Binding Controller.LeftTrigger, Converter={StaticResource FractionToLength}, ConverterParameter=90}" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                    <Run Text="LT " /><Run Text="{Binding Controller.LeftTriggerText, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Border Canvas.Left="390" Canvas.Top="8" Width="92" Height="28" CornerRadius="6" Background="{StaticResource CardHoverBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Border HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Opacity="0.75"
                                        Width="{Binding Controller.RightTrigger, Converter={StaticResource FractionToLength}, ConverterParameter=90}" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                    <Run Text="RT " /><Run Text="{Binding Controller.RightTriggerText, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- stick wells -->
                        <Ellipse Canvas.Left="116" Canvas.Top="100" Width="72" Height="72" Fill="{StaticResource BgBrush}" />
                        <Ellipse Canvas.Left="314" Canvas.Top="182" Width="72" Height="72" Fill="{StaticResource BgBrush}" />

                        <!-- buttons -->
                        <ItemsControl ItemsSource="{Binding Controller.Buttons}" Width="560" Height="300">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding W}" Height="{Binding H}" CornerRadius="{Binding Corner}" BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBound}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GreenBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- stick position dots -->
                        <Ellipse Width="16" Height="16" Fill="{StaticResource AccentBrush}" IsHitTestVisible="False"
                                 Canvas.Left="{Binding Controller.LeftDotX}" Canvas.Top="{Binding Controller.LeftDotY}" />
                        <Ellipse Width="16" Height="16" Fill="{StaticResource AccentBrush}" IsHitTestVisible="False"
                                 Canvas.Left="{Binding Controller.RightDotX}" Canvas.Top="{Binding Controller.RightDotY}" />
                    </Canvas>
                </Viewbox>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="XInput exposes A B X Y, LB RB, LT RT, LS RS, D-Pad, View and Menu. Paddles (Elite, GameSir) appear as whatever button the controller maps them to." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
