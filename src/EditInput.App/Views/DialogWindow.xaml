<Window x:Class="EditInput.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="24,22">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13" />
        <TextBox x:Name="Input" Margin="0,14,0,0" Visibility="Collapsed" MaxLength="48" />
        <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0" />
    </StackPanel>
</Window>
