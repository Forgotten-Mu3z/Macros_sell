<Window x:Class="EditInput.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:EditInput.App.Views"
        xmlns:vm="clr-namespace:EditInput.App.ViewModels"
        Title="Fortnite Edit Input" Width="1100" Height="780" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        Icon="/Assets/app.ico" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ───── header ───── -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="/Assets/icon256.png" Width="34" Height="34" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FORTNITE EDIT INPUT" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="{Binding ProfileTitle}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- status pill -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="14,6" Margin="0,0,18,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="13"
                                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="PROFILE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="190" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              AutomationProperties.Name="Profile" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New Profile" Margin="6,0,0,0" Command="{Binding NewProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Save Profile" Command="{Binding SaveProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Duplicate Profile" Command="{Binding DuplicateProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" ToolTip="Rename Profile" Command="{Binding RenameProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete Profile" Command="{Binding DeleteProfileCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ───── navigation ───── -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="CONTROLLER" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding Controller.Status}" FontSize="12" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Controller.IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE765;" Content="Edit Binds"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Edit}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8AB;" Content="Simple Remap"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Remap}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Controller"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Controller}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xEBE8;" Content="Debug"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Debug}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ───── pages ───── -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{StaticResource RedSoftBrush}" BorderBrush="{StaticResource RedBrush}" BorderThickness="0,0,0,1"
                    Padding="20,10" Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Banner}" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,20,22,8">
                <Grid>
                    <v:EditPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Edit}" />
                    <v:RemapPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Remap}" />
                    <v:ControllerPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Controller}" />
                    <v:DebugPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Debug}" />
                    <v:SettingsPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Settings}" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ───── footer ───── -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource PrimaryButton}" Content="ENABLE" Width="110" Command="{Binding EnableCommand}" />
                    <Button Content="DISABLE" Width="110" Margin="10,0,0,0" Command="{Binding DisableCommand}" />
                    <Button Content="SETTINGS" Width="110" Margin="10,0,0,0" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="EMERGENCY STOP"
                        Command="{Binding EmergencyStopCommand}" ToolTip="Release every generated input and stop automation" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="STATE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StateText}" FontWeight="Bold" Margin="8,0,24,0" VerticalAlignment="Center" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center">
                        <Run Text="{Binding Settings.Toggle.Display, Mode=OneWay}" /><Run Text=" enable/disable  •  " />
                        <Run Text="{Binding Settings.EmergencyStop.Display, Mode=OneWay}" /><Run Text=" emergency stop" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ───── bind capture overlay ───── -->
        <Grid Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#C8080A0F"
              Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30"
                    BorderBrush="{StaticResource AccentBrush}">
                <StackPanel>
                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="30" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding CaptureTitle}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CaptureText}" FontSize="15" HorizontalAlignment="Center" Margin="0,14,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="Press any key, mouse button, or controller button.&#10;Press ESC to cancel."
                               Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Automation is paused until the captured input is released."
                               Style="{StaticResource Hint}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
