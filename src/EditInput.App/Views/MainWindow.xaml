<Window x:Class="EditInput.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:EditInput.App.Views"
        Title="Fortnite Edit Input" Width="1120" Height="800" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/app.ico" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Custom chrome: keeps native resize, snap and shadow, but we draw the title bar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- soft glow in the top-left corner -->
            <Ellipse Grid.RowSpan="5" Width="700" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-260,-240,0,0" IsHitTestVisible="False" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3300D9FF" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Grid.RowSpan="5" Width="700" Height="460" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-260,-280,0" IsHitTestVisible="False" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#338B5CFF" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- ───── title bar ───── -->
            <DockPanel Grid.Row="0" Margin="18,0,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" />
                </StackPanel>

                <!-- profile picker -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Width="200" MinHeight="32" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              AutomationProperties.Name="Profile" />
                    <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="10,0,4,0" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New Profile" Command="{Binding NewProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Save Profile" Command="{Binding SaveProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Duplicate Profile" Command="{Binding DuplicateProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" ToolTip="Rename Profile" Command="{Binding RenameProfileCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete Profile" Command="{Binding DeleteProfileCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/icon256.png" Width="22" Height="22" Margin="0,0,12,0" />
                    <TextBlock Text="FORTNITE" FontWeight="Black" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text=" EDIT INPUT" FontWeight="Black" FontSize="13" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentGradientH}" />
                    <Border Background="{StaticResource CardHoverBrush}" CornerRadius="6" Padding="8,2" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProfileTitle}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- ───── status hero ───── -->
            <Border Grid.Row="1" Margin="20,6,20,0" CornerRadius="16" Padding="24,18" Background="{StaticResource HeroGradient}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- glowing status orb -->
                    <Grid Width="60" Height="60" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Ellipse Fill="{Binding StatusBrush}" Opacity="0.12" />
                        <Ellipse Width="40" Height="40" Fill="{Binding StatusBrush}" Opacity="0.18" />
                        <Ellipse Width="20" Height="20" Fill="{Binding StatusBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{Binding StatusBrush.Color}" BlurRadius="26" ShadowDepth="0" Opacity="1" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="24" FontWeight="Black"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="STATE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,2" Margin="8,0,16,0">
                                <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Consolas" />
                            </Border>
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding Settings.Toggle.Display, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <Run Text=" enable / disable     " />
                                <Run Text="{Binding Settings.EmergencyStop.Display, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource RedBrush}" />
                                <Run Text=" emergency stop" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Height="46" MinWidth="124" Command="{Binding EnableCommand}"
                                ToolTip="Start automation (also leaves emergency stop)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="ENABLE" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Height="46" MinWidth="124" Margin="10,0,0,0" Command="{Binding DisableCommand}" ToolTip="Pause automation">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="DISABLE" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Height="46" MinWidth="124" Margin="10,0,0,0"
                                Command="{Binding EmergencyStopCommand}" ToolTip="Release every generated input and stop">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="E-STOP" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ───── alert banner ───── -->
            <Border Grid.Row="2" Margin="20,12,20,0" CornerRadius="12" Padding="16,11" Background="{StaticResource RedSoftBrush}"
                    BorderBrush="{StaticResource RedBrush}" BorderThickness="1"
                    Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource RedBrush}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Banner}" Foreground="{StaticResource RedBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- ───── tabs ───── -->
            <Grid Grid.Row="3" Margin="20,16,20,0">
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource BorderBrush}" Margin="0,0,0,-8" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE765;" Content="Edit Binds"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Edit}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8AB;" Content="Simple Remap"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Remap}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Controller"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Controller}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xEBE8;" Content="Debug"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Debug}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}" />
                </StackPanel>

                <!-- controller chip -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16" Padding="12,6"
                        Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Controller.IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Controller.Status}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ───── pages ───── -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="20,22,20,6">
                <Grid>
                    <v:EditPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Edit}" />
                    <v:RemapPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Remap}" />
                    <v:ControllerPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Controller}" />
                    <v:DebugPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Debug}" />
                    <v:SettingsPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVis}, ConverterParameter=Settings}" />
                </Grid>
            </ScrollViewer>

            <!-- ───── bind capture overlay ───── -->
            <Grid Grid.RowSpan="5" Background="#D905060B"
                  Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
                <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,30" CornerRadius="18"
                        Background="{StaticResource CardGradient}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.35" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Width="84" Height="84" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <!-- pulsing ring; animates only while capturing -->
                            <Ellipse Stroke="{StaticResource AccentGradient}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform />
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Pulse">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.7" To="1.1" Duration="0:0:1.1" />
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.7" To="1.1" Duration="0:0:1.1" />
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:1.1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="56" Height="56" Fill="{StaticResource AccentSoftBrush}" />
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding CaptureTitle}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CaptureText}" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,0"
                                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Text="Press any key, mouse button, or controller button.&#10;Press ESC to cancel."
                                   Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="Automation is paused until the captured input is released."
                                   Style="{StaticResource Hint}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
