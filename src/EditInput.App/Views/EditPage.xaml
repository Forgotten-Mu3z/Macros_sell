<UserControl x:Class="EditInput.App.Views.EditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:EditInput.App.Controls">
    <StackPanel>
        <!-- remap mode notice -->
        <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"
                Visibility="{Binding Editor.IsRemap, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Use Edit Automation" Click="OnUseAutomation"
                        VerticalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="This profile is in Simple Remap mode: one input → one input, every automation feature below is off. Mappings are on the Simple Remap tab." />
            </DockPanel>
        </Border>

        <!-- ───── binds ───── -->
        <Border Style="{StaticResource Card}" IsEnabled="{Binding Editor.IsAutomation}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,3,0,0"
                               Text="Click a key to change it" />
                    <ContentControl Content="Binds" ContentTemplate="{StaticResource CardHeader}" />
                </DockPanel>
                <UniformGrid Columns="4">
                    <ContentControl Content="{Binding Editor.Edit}" ContentTemplate="{StaticResource BindSlotTemplate}" Margin="0,0,7,0" />
                    <ContentControl Content="{Binding Editor.Select}" ContentTemplate="{StaticResource BindSlotTemplate}" Margin="7,0,7,0" />
                    <ContentControl Content="{Binding Editor.Reset}" ContentTemplate="{StaticResource BindSlotTemplate}" Margin="7,0,7,0" />
                    <ContentControl Content="{Binding Editor.Confirm}" ContentTemplate="{StaticResource BindSlotTemplate}" Margin="7,0,0,0" />
                </UniformGrid>

                <!-- live preview of what one Edit press does -->
                <TextBlock Text="WHAT HAPPENS WHEN YOU PRESS EDIT" Style="{StaticResource SectionLabel}" Margin="0,4,0,8" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12,10"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding Editor.SequenceSteps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                                    <Border x:Name="Chip" CornerRadius="7" Padding="10,5" Background="{StaticResource CardHoverBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="wait">
                                        <Setter TargetName="Chip" Property="Background" Value="Transparent" />
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AmberBrush}" />
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource AmberBrush}" />
                                        <Setter TargetName="ChipText" Property="FontFamily" Value="Consolas" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="hold">
                                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentGradient}" />
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                                        <Setter TargetName="ChipText" Property="Foreground" Value="#050712" />
                                        <Setter TargetName="ChipText" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="info">
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ───── behavior ───── -->
            <Border Style="{StaticResource Card}" IsEnabled="{Binding Editor.IsAutomation}">
                <StackPanel>
                    <ContentControl Content="Behavior" ContentTemplate="{StaticResource CardHeader}" />

                    <DockPanel Margin="0,0,0,18">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Editor.ResetBeforeSelect}"
                                  VerticalAlignment="Center" AutomationProperties.Name="Reset before select" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="RESET BEFORE SELECT" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                            <TextBlock Style="{StaticResource Hint}" Text="Tap Reset once, wait the reset delay, then start Select." />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="SELECT MODE" Style="{StaticResource SectionLabel}" />
                    <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Editor.SelectModes}" SelectedValuePath="Value"
                             SelectedValue="{Binding Editor.SelectMode}" AutomationProperties.Name="Select mode" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Editor.SelectModeHint}" Margin="2,6,0,18" />

                    <TextBlock Text="AUTO CONFIRM" Style="{StaticResource SectionLabel}" />
                    <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Editor.ConfirmModes}" SelectedValuePath="Value"
                             SelectedValue="{Binding Editor.AutoConfirm}" AutomationProperties.Name="Auto confirm" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Editor.ConfirmModeHint}" Margin="2,6,0,18" />

                    <TextBlock Text="DEVICE MODE" Style="{StaticResource SectionLabel}" />
                    <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Editor.DeviceModes}" SelectedValuePath="Value"
                             SelectedValue="{Binding Editor.DeviceMode}" AutomationProperties.Name="Device mode" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Editor.DeviceModeHint}" Margin="2,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ───── timing + hotkeys ───── -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" IsEnabled="{Binding Editor.IsAutomation}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Padding="12,5" FontSize="12"
                                    VerticalAlignment="Top" Command="{Binding Editor.OneMsStepsCommand}"
                                    ToolTip="Set every delay and tap to 1 ms">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="All 1 ms" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ContentControl Content="Timing" ContentTemplate="{StaticResource CardHeader}" />
                        </DockPanel>
                        <c:SliderSetting Label="RESET DELAY" Hint="Reset → Select" Minimum="0" Maximum="100" Value="{Binding Editor.ResetDelayMs}" />
                        <c:SliderSetting Label="SELECT DELAY" Hint="Edit → Select" Minimum="0" Maximum="100" Value="{Binding Editor.SelectDelayMs}" />
                        <c:SliderSetting Label="TAP DURATION" Hint="How long taps are held" Minimum="0" Maximum="100" Value="{Binding Editor.TapDurationMs}" />
                        <c:SliderSetting Label="CONFIRM DELAY" Hint="Select up → Confirm" Minimum="0" Maximum="100" Value="{Binding Editor.ConfirmDelayMs}" />
                        <TextBlock Style="{StaticResource Hint}" FontSize="11.5"
                                   Text="Default is 1 ms between every step. If the game misses the Reset or Confirm tap, raise TAP DURATION a little (games read input once per frame, ≈4–16 ms)." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ContentControl Content="Global Hotkeys" ContentTemplate="{StaticResource CardHeader}" />
                        <UniformGrid Columns="2">
                            <ContentControl Content="{Binding Settings.Toggle}" ContentTemplate="{StaticResource BindSlotTemplate}" Margin="0,0,7,0" />
                            <ContentControl Content="{Binding Settings.EmergencyStop}" ContentTemplate="{StaticResource BindSlotTemplate}" Margin="7,0,0,0" />
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Emergency Stop releases every generated input and stays stopped until you click ENABLE." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <ContentControl Content="Bind Check" ContentTemplate="{StaticResource CardHeader}" />
                <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueTemplate}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
