<Window x:Class="EditInput.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CardBrush}" FontFamily="{StaticResource UiFont}" Icon="/Assets/app.ico">
    <StackPanel Margin="32,28">
        <Image Source="/Assets/icon256.png" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,14" />
        <TextBlock Text="Welcome" FontSize="24" FontWeight="Bold" />
        <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,20"
                   Text="Hold your Edit key and the app holds Select for you, so you can drag across edit tiles. Release Edit and everything is released." />

        <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="DEFAULT BINDINGS" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                <TextBlock Grid.Row="1" Text="Edit" Foreground="{StaticResource MutedBrush}" Margin="0,0,24,6" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="E" FontWeight="SemiBold" />
                <TextBlock Grid.Row="2" Text="Select" Foreground="{StaticResource MutedBrush}" Margin="0,0,24,6" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="P" FontWeight="SemiBold" />
                <TextBlock Grid.Row="3" Text="Reset Before Select" Foreground="{StaticResource MutedBrush}" Margin="0,0,24,6" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="OFF" FontWeight="SemiBold" />
                <TextBlock Grid.Row="4" Text="Select Mode" Foreground="{StaticResource MutedBrush}" Margin="0,0,24,0" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Hold Until Edit Released" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <StackPanel Margin="0,18,0,0">
            <TextBlock><Run Text="Press " /><Run Text="F8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" /><Run Text=" to Enable/Disable" /></TextBlock>
            <TextBlock Margin="0,4,0,0"><Run Text="Press " /><Run Text="F12" FontWeight="Bold" Foreground="{StaticResource RedBrush}" /><Run Text=" for Emergency Stop" /></TextBlock>
        </StackPanel>

        <TextBlock Style="{StaticResource Hint}" FontSize="11" Margin="0,18,0,0"
                   Text="Every bind can be changed. Automation that sends inputs for you may be restricted in competitive play – check the rules of the game and event you play in." />

        <Button Content="Start" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="120" Margin="0,22,0,0"
                IsDefault="True" Click="OnStart" />
    </StackPanel>
</Window>
